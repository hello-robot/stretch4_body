#!/usr/bin/env bash
# Run the unit tests that match the stretch4_body modules staged in this commit
# (stretch4_body/.../foo.py -> test/test_foo*.py) and refuse the commit if they fail.
# Install once per clone: git config core.hooksPath .githooks
# Skip one commit (say why in the message): HELLO_SKIP_TESTS=1 git commit ...
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
[ "${HELLO_SKIP_TESTS:-0}" = "1" ] && exit 0
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- 'stretch4_body/*.py' 'stretch4_body/**/*.py' 'test/test_*.py')
[ ${#staged[@]} -eq 0 ] && exit 0
tests=()
for f in "${staged[@]}"; do
  case "$f" in
    test/test_*.py) tests+=("$f") ;;
    stretch4_body/*.py)
      mod="$(basename "$f" .py)"
      for t in "$root"/test/test_"$mod"*.py; do [ -e "$t" ] && tests+=("${t#$root/}"); done ;;
  esac
done
[ ${#tests[@]} -eq 0 ] && { echo "pre-commit: no unit test covers the staged modules (write one under test/)"; exit 0; }
mapfile -t tests < <(printf '%s\n' "${tests[@]}" | sort -u)
python3 -c 'import pytest' 2>/dev/null || { echo "pre-commit: pytest not installed, tests skipped"; exit 0; }
if ! (cd "$root" && python3 -m pytest -q -x "${tests[@]}" 2>&1 | tee build-pre-commit.log | tail -25); then
  echo "pre-commit: tests failed (${tests[*]}). Commit refused."
  rm -f "$root/build-pre-commit.log"
  exit 1
fi
rm -f "$root/build-pre-commit.log"
exit 0
